PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API=https://api-m.sandbox.paypal.com
SELLER_EMAIL=
ANTHROPIC_API_KEY=
CHANNEL3_API_KEY=
# Optional: model for reading buyer messages (default claude-haiku-5-5)
AGENT_MODEL=
# Shared secret for the scheduled hold-expiry call (any long random string)
CRON_SECRET=
# Set to 1 on the hosted demo: shows "Reset demo", "Simulate 5 buyers" and the judge's tour
DEMO_MODE=
# Optional: sandbox buyer login shown in the judge's tour (sandbox only, no real money)
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
# Browser push notifications: generate with  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
